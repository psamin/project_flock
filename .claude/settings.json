{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)", "Bash(pytest*)", "Bash(ruff*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git status*)",
      "Bash(git diff*)", "Bash(mkdir*)", "Bash(ls*)", "Bash(cat*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "cd $CLAUDE_PROJECT_DIR && ruff format . >/dev/null 2>&1; ruff check --fix . >/dev/null 2>&1; true" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh" }] }
    ]
  }
}
